APP_ENV=development
DATABASE_URL=sqlite:///./modium.db
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_BASE_URL=http://127.0.0.1:8010
# Local SMTP example (Mailpit). Production requires authenticated SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# Production: PostgreSQL, HTTPS and Redis required.
REDIS_URL=
